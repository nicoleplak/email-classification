# Settings for running on a laptop (docs/LOCAL_TESTING.md).
#
# Copy this file to ".env" in the repository root (the email-classification folder, next to README.md),
# fill in section 1 (and 3 if you copy real emails from Azure), and keep it private: .env is git-ignored and
# never goes into the container image. Never commit keys or send them by email or chat.
#
# Read by: the classifier (python -m main), the review app, tools/fetch_sample.py, tools/import_msg.py and the
# mailbox ingest. Not by the unit tests or tools/local_demo.py (they need no settings).
# A setting typed in PowerShell ($env:NAME = "...") wins over the same one here.
# Lines starting with # are off; remove the # to switch one on.


# ---------------------------------------------------------------- 1. Model keys (required to classify)
# Azure portal → Azure OpenAI resource → Keys and Endpoint; the deployment name is in Azure AI Foundry.
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=<deployment name>
AZURE_OPENAI_API_VERSION=<api version, as used by the Azure job>

# Azure portal → Document Intelligence resource → Keys and Endpoint (reads PDF / image attachments).
DOC_INTEL_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/
DOC_INTEL_API_KEY=<key>


# ---------------------------------------------------------------- 2. Work on local folders, not on Azure
# Full paths (the classifier runs from AI_email_classifier\, the app from the repository root, so relative
# paths would point to different folders). local_data\ is git-ignored.
LOCAL_BLOB_DIR=C:\path\to\email-classification\local_data\blob
LOCAL_STORE_DIR=C:\path\to\email-classification\local_data\case_store
CASE_STORE=local
# The classifier works through the "container" (here: LOCAL_BLOB_DIR): register new runs, classify, save results.
UPLOAD_RESULTS_TO_BLOB=true
REVIEW_AUTH=dev
PORT=8765


# ---------------------------------------------------------------- 3. Copy real emails from Azure (tools/fetch_sample.py)
# Read-only. Use ONE of the three ways in; with none of them set, your az login is used
# (needs a Storage Blob Data Reader role on the container).
RESULT_STORAGE_ACCOUNT=datallmdev
RESULT_CONTAINER=email-classification
# STG_KEY=<storage account key>                       # Azure portal → datallmdev → Access keys
# AZURE_STORAGE_CONNECTION_STRING=<connection string>  # same page; only one of STG_KEY / connection string
# AZURE_TENANT_ID=<tenant id>                          # only for az login with more than one tenant


# ---------------------------------------------------------------- 4. Classifier behaviour (optional; defaults shown)
# AUTO_ACCEPT_THRESHOLD=0.90          # certainty from which an email is handled automatically
# EXTRA_CATEGORY_THRESHOLD=0.80       # certainty from which a 2nd / 3rd category is added with its actions
# CLASSIFIER_PAUSED=false             # true: register emails as cases, skip the model calls
# CLASSIFY_MAX_PER_RUN=0              # 0 = every waiting email; e.g. 5 to try a few at a time
# CLASSIFY_TIME_BUDGET_SECONDS=0      # 0 = no time limit on a laptop (Azure uses 2700)
# REGISTER_RUNS_FROM=                 # skip ingest runs before this UTC time (YYYYMMDDTHHMMSSZ); empty = all
# REGISTRY_SOURCE=csv                 # csv: newest in/qualco_output_*.csv in LOCAL_BLOB_DIR; synapse: see below
# REGISTRY_CSV=C:\path\to\qualco_output_YYYYMMDD.csv   # a registry file you already have, instead of the one in the folder
# REQUEST_HISTORY=true                # read in/request_output_*.csv (past Qualco requests) when it is there
# UNDERSTAND_ENABLED=true             # read customer details, flags and actions (false: category only)
# ACCOUNT_STATUS_COLUMN=              # registry column with the open/closed Qualco case (not delivered yet)
# ACCOUNT_CLOSED_VALUES=CLOSED,C,Κλειστός,ΚΛΕΙΣΤΟΣ   # its values that mean "closed" (then the _Cust request)


# ---------------------------------------------------------------- 5. Not needed on a laptop (Azure / mailbox only)
# Mailbox ingest from Outlook (graphapi/), only to fetch mail yourself; reads the real mailbox:
# GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
# DOVALUEGREECE_ID=<tenant id>
# CLIENT_ID=<app registration id>
# CLIENT_SECRET=<app secret>
# SCOPE=https://graph.microsoft.com/.default
# USER_ID=<shared mailbox address>
# FETCH_ATTACHMENTS=true
# MAX_EMAILS=5
# EXCLUDE_DOMAINS=dovaluegreece,eurobank
# DELTA_BOOTSTRAP_DAYS=1
#
# Shared case store in Azure (instead of CASE_STORE=local; changes what reviewers see):
# CASE_STORE=cosmos
# COSMOS_ENDPOINT=https://<cosmos account, e.g. cosmos-db-data-llm-dev>.documents.azure.com:443/
# COSMOS_DATABASE=EmailClassification
# AZURE_CLI_SUBSCRIPTION=doValue - Prod Envs
#
# Customer registry from Synapse (unreachable from Azure today, see DEPLOY.md):
# REGISTRY_SOURCE=synapse
# SYNAPSE_SERVER=dwhgruatsyn.sql.azuresynapse.net
# SYNAPSE_DATABASE=dwhuat
# SYNAPSE_ODBC_DRIVER=ODBC Driver 17 for SQL Server
#
# Review app in Azure only:
# REVIEW_AUTH=demo
# REVIEW_ACCESS_CODE=<12+ characters>
# REVIEW_SESSION_SECRET=<random>
# FETCH_CRON=0 */4 * * *
