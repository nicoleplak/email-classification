<mxfile host="app.diagrams.net" agent="tools/rules_drawio.py" version="24.7.17"><diagram id="1 Διαδρομή email" name="1 Διαδρομή email"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 Δ-1" value='&lt;b style="font-size:20px"&gt;Κανόνες αποφάσεων email&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Η διαδρομή ενός email · πηγή: rules_for_prompt-2.xlsx (Νοέμβριος 2026)&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="40" as="geometry"/></mxCell><mxCell id="1 Δ-2" value="Νέο email" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fillColor=#18212B;strokeColor=#18212B;" vertex="1" parent="1"><mxGeometry x="150" y="80" width="200" height="44" as="geometry"/></mxCell><mxCell id="1 Δ-3" value='&lt;b&gt;0 · Εσωτερικός αποστολέας;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;@dovaluegreece.gr, όχι Retail Support&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-4" value='&lt;b&gt;1 · Ταξινόμηση&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;κύριο αίτημα + λοιπά (από 80% αυτόματα)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="290" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-5" value='&lt;b&gt;2 · Σειρά αιτημάτων&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;προτεραιότητα 1 → 3 · παράπονο τελευταίο&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-6" value='&lt;b&gt;3 · Κανόνες κατηγορίας&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ό,τι λέει το email → ενέργεια&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="470" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-7" value='&lt;b&gt;4 · Portal;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;αίτημα Portal + πελάτης με Portal&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-8" value='&lt;b&gt;5 · Ταυτοποίηση;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ΑΦΜ ή λογαριασμός στο μητρώο&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="710" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-9" value='&lt;b&gt;6 · Λογαριασμός;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;από email · τράπεζα/SPV στο κείμενο · αλλιώς ανά SPV&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="850" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-10" value='&lt;b&gt;7 · Κωδικός αιτήματος Qualco&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ανοιχτή: χωρίς _Cust · κλειστή: _Cust&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="990" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-11" value='&lt;b&gt;8 · Activity Qualco&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ίδιος λογαριασμός · μόνο αυτή (follow-up) αν το αίτημα υπάρχει ήδη&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D7A4C;strokeWidth=2;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="1080" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-12" value='&lt;b&gt;9 · Μία απάντηση ανά email&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;από τα πρότυπα (δεξιά)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="1170" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-13" value='&lt;b&gt;10 · Αυτόματα;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;κανένας λόγος ελέγχου&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="1260" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-14" value="Αυτόματα" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fillColor=#1D7A4C;strokeColor=#1D7A4C;" vertex="1" parent="1"><mxGeometry x="150" y="1400" width="200" height="44" as="geometry"/></mxCell><mxCell id="1 Δ-15" value="Προς έλεγχο" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fillColor=#A14D0E;strokeColor=#A14D0E;" vertex="1" parent="1"><mxGeometry x="600" y="1285" width="200" height="50" as="geometry"/></mxCell><mxCell id="1 Δ-16" value='&lt;b&gt;Κατηγορία 38 · αυτόματα&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;χωρίς μοντέλο · φάκελος doValueGreece-noreply&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D7A4C;dashed=1;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="165" width="280" height="70" as="geometry"/></mxCell><mxCell id="1 Δ-17" value='&lt;b&gt;Χωρίς πελάτη&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;προώθηση · φάκελος Outlook · τράπεζα · προσωπικό&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;dashed=1;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="460" width="280" height="80" as="geometry"/></mxCell><mxCell id="1 Δ-18" value='&lt;b&gt;Πρότυπο Portal&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;αντί για το αίτημα (π.χ. 113, 89, 119)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#6A4FB0;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="595" width="280" height="50" as="geometry"/></mxCell><mxCell id="1 Δ-19" value='&lt;b&gt;Need more Info&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ζητάμε ΑΦΜ&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#6A4FB0;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="735" width="280" height="50" as="geometry"/></mxCell><mxCell id="1 Δ-20" value='&lt;b&gt;Need more Info&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"