<mxfile host="app.diagrams.net" agent="tools/rules_drawio.py" version="24.7.17"><diagram id="1 Διαδρομή email" name="1 Διαδρομή email"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 Δ-1" value='&lt;b style="font-size:20px"&gt;Κανόνες αποφάσεων email&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Η διαδρομή ενός email · πηγή: rules_for_prompt.xlsx (Νοέμβριος 2026)&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="820" height="40" as="geometry"/></mxCell><mxCell id="1 Δ-2" value="Νέο email" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fillColor=#18212B;strokeColor=#18212B;" vertex="1" parent="1"><mxGeometry x="150" y="80" width="200" height="44" as="geometry"/></mxCell><mxCell id="1 Δ-3" value='&lt;b&gt;1 · Ταξινόμηση&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;κύριο αίτημα + λοιπά (από 80% αυτόματα)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-4" value='&lt;b&gt;2 · Σειρά αιτημάτων&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;προτεραιότητα 1 → 3 · παράπονο τελευταίο&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-5" value='&lt;b&gt;3 · Κανόνες κατηγορίας&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ό,τι λέει το email → ενέργεια&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="340" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-6" value='&lt;b&gt;4 · Portal;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;κατηγορία και πελάτης με Portal&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-7" value='&lt;b&gt;5 · Ταυτοποίηση;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ΑΦΜ ή λογαριασμός στο μητρώο&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-8" value='&lt;b&gt;6 · Λογαριασμός;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;βρέθηκε λογαριασμός / SPV&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-9" value='&lt;b&gt;7 · Κωδικός Qualco&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ανοιχτή: χωρίς _Cust · κλειστή: _Cust&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="860" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-10" value='&lt;b&gt;8 · Μία απάντηση ανά email&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;από τα πρότυπα (δεξιά)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="950" width="300" height="60" as="geometry"/></mxCell><mxCell id="1 Δ-11" value='&lt;b&gt;9 · Αυτόματα;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;κανένας λόγος ελέγχου&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F0F7;strokeColor=#155E8F;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="1050" width="340" height="100" as="geometry"/></mxCell><mxCell id="1 Δ-12" value="Αυτόματα" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fillColor=#1D7A4C;strokeColor=#1D7A4C;" vertex="1" parent="1"><mxGeometry x="150" y="1190" width="200" height="44" as="geometry"/></mxCell><mxCell id="1 Δ-13" value="Προς έλεγχο" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fillColor=#A14D0E;strokeColor=#A14D0E;" vertex="1" parent="1"><mxGeometry x="600" y="1075" width="200" height="50" as="geometry"/></mxCell><mxCell id="1 Δ-14" value='&lt;b&gt;Χωρίς πελάτη&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;προώθηση · φάκελος Outlook · activity · τράπεζα · προσωπικό&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5663;dashed=1;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="280" height="80" as="geometry"/></mxCell><mxCell id="1 Δ-15" value='&lt;b&gt;Πρότυπο Portal&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;αντί για αίτημα Qualco&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#6A4FB0;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="465" width="280" height="50" as="geometry"/></mxCell><mxCell id="1 Δ-16" value='&lt;b&gt;Need more Info&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ζητάμε ΑΦΜ&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#6A4FB0;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="605" width="280" height="50" as="geometry"/></mxCell><mxCell id="1 Δ-17" value='&lt;b&gt;Need more Info&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4A5663"&gt;ζητάμε αριθμό λογαριασμού&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#6A4FB0;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="745" width="280" height="50" as="geometry"/></mxCell><mxCell id="1 Δ-18" value='&lt;b&gt;Πρότυπα απάντησης&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;1 Need more Info&lt;br&gt;2 Portal · 3 Eurobank&lt;br&gt;4 Received / In Progress της κατηγορίας&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EDFA;strokeColor=#6A4FB0;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="900" width="280" height="110" as="geometry"/></mxCell><mxCell id="1 Δ-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-2" target="1 Δ-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-3" target="1 Δ-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-4" target="1 Δ-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-9" target="1 Δ-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-10" target="1 Δ-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-24" value="αίτημα Qualco" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-5" target="1 Δ-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-25" value="άλλη ενέργεια" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-5" target="1 Δ-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-26" value="ναι" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-6" target="1 Δ-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-27" value="όχι, ή τεχνικό πρόβλημα" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-6" target="1 Δ-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-28" value="όχι" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-7" target="1 Δ-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-29" value="ναι" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-7" target="1 Δ-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-30" value="όχι" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-8" target="1 Δ-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-31" value="ναι" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-8" target="1 Δ-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-32" value="ναι" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-11" target="1 Δ-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-33" value="όχι" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5663;fontColor=#4A5663;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-11" target="1 Δ-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6A4FB0;fontColor=#6A4FB0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="1 Δ-14" target="1 Δ-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6A4FB0;fontColor=#6A4FB0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="1 Δ-15" target="1 Δ-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6A4FB0;fontColor=#6A4FB0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="1 Δ-16" target="1 Δ-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6A4FB0;fontColor=#6A4FB0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="1 Δ-17" target="1 Δ-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-38" value="μία απάντηση" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6A4FB0;fontColor=#6A4FB0;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1 Δ-18" target="1 Δ-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 Δ-39" value='&lt;font color="#4A5663"&gt;Τα βήματα 4–7 ισχύουν για κάθε αίτημα Qualco του email, με τη σειρά του βήματος 2. Το Portal παρακάμπτεται όταν ο πελάτης αναφέρει τεχνικό πρόβλημα ή όταν το ίδιο email έχει αίτημα που δεν γίνεται στο Portal.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="820" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2 Κριτήρια και λογαριασμός" name="2 Κριτήρια και λογαριασμός"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 Κ-1" value='&lt;b style="font-size:20px"&gt;Τα βασικά κριτήρια&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="2 Κ-2" value="&lt;b&gt;Ταυτοποίηση: μόνο ΑΦΜ ή λογαριασμός&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ο πελάτης ταυτοποιείται μόνο με ΑΦΜ (με σωστό ψηφίο ελέγχου) ή αριθμό λογαριασμού που υπάρχουν στο μητρώο. Όνομα και email είναι συμπληρωματικά: «πιθανός» πελάτης, ποτέ αυτόματη επεξεργασία." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="265" height="200" as="geometry"/></mxCell><mxCell id="2 Κ-3" value="&lt;b&gt;Προτεραιότητα: το πιο σημαντικό αίτημα πρώτο&lt;/b&gt;&lt;br&gt;&lt;br&gt;Με πολλά αιτήματα, κύριο είναι αυτό με τη μικρότερη προτεραιότητα (1 = πιο σημαντικό). Το «Παράπονα» είναι κύριο μόνο όταν το email δεν ζητά τίποτε άλλο και η δυσαρέσκεια είναι έντονη." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="265" height="200" as="geometry"/></mxCell><mxCell id="2 Κ-4" value="&lt;b&gt;Δεύτερη και τρίτη κατηγορία από 80%&lt;/b&gt;&lt;br&gt;&lt;br&gt;Όταν ο ταξινομητής βρίσκει και άλλο αίτημα με βεβαιότητα 80% ή περισσότερο (τουλάχιστον 4 στα 5 δείγματα), η κατηγορία προστίθεται αυτόματα, έως δύο, μαζί με τις ενέργειές της. Κάτω από 80% είναι μόνο πρόταση στον ελεγκτή." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="265" height="200" as="geometry"/></mxCell><mxCell id="2 Κ-5" value="&lt;b&gt;Portal πρώτα&lt;/b&gt;&lt;br&gt;&lt;br&gt;Σε κατηγορίες με Portal = YES, ο πελάτης με Portal flag παίρνει απάντηση να το κάνει από το Portal, εκτός αν αναφέρει τεχνικό πρόβλημα. Τότε ανοίγει κανονικά το αίτημα Qualco." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="70" width="265" height="200" as="geometry"/></mxCell><mxCell id="2 Κ-6" value='&lt;b style="font-size:20px"&gt;Σε ποιον λογαριασμό ανοίγει το αίτημα&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1100" height="40" as="geometry"/></mxCell><mxCell id="2 Κ-7" value='&lt;b&gt;Ανά SPV&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ένα αίτημα σε κάθε χαρτοφυλάκιο (SPV) του πελάτη, σε έναν λογαριασμό του. Αν το email αναφέρει λογαριασμό, σε αυτόν.&lt;br&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;• GDPR&lt;br&gt;• Αιτήματα Ν.3869&lt;br&gt;• Αντιλογισμοί&lt;br&gt;• Ασφαλιστήρια&lt;br&gt;• Βεβαιώσεις εξόφλησης&lt;br&gt;• Βεβαιώσεις οφειλής&lt;br&gt;• Ηχογραφημένες κλήσεις&lt;br&gt;• Πλειστηριασμοί&lt;br&gt;• Πόθεν έσχες&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="350" height="330" as="geometry"/></mxCell><mxCell id="2 Κ-8" value='&lt;b&gt;Ο λογαριασμός&lt;/b&gt;&lt;br&gt;&lt;br&gt;Πρέπει να ταυτοποιηθεί ο λογαριασμός: από το email, ή ο μοναδικός του πελάτη, ή όλοι όταν ζητά για όλες τις οφειλές. Αλλιώς Need more Info.&lt;br&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;• Αιτήματα που αφορούν στον εξωδικαστικό 4605&lt;br&gt;• Αιτήματα που αφορούν στον εξωδικαστικό 4738&lt;br&gt;• Αμφισβήτηση οφειλής&lt;br&gt;• Αντίγραφα συμβάσεων&lt;br&gt;• Βεβαίωση άρσης προσημείωσης&lt;br&gt;• Βεβαίωση_Καταβολών_Βεβαίωση_Τόκων&lt;br&gt;• Διαμεσολάβηση - ρύθμιση&lt;br&gt;• Δοσολόγιο&lt;br&gt;• Κίνηση λογαριασμού&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="350" height="330" as="geometry"/></mxCell><mxCell id="2 Κ-9" value='&lt;b&gt;Το SPV&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ένα αίτημα σε έναν λογαριασμό του SPV που ταυτοποιείται: από λογαριασμό του email, ή το μοναδικό SPV, ή κάθε SPV για όλες τις οφειλές. Αλλιώς Need more Info.&lt;br&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;• Εθελοντική εκποίηση&lt;br&gt;• Εξασφαλίσεις&lt;br&gt;• Εξουσιοδοτήσεις&lt;br&gt;• Επικαιροποίηση στοιχείων με επισύναψη υπεύθυνης δήλωσης&lt;br&gt;• Νομιμοποίηση κληρονόμων με επισύναψη εγγράφων&lt;br&gt;• Ρύθμιση&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="340" width="350" height="330" as="geometry"/></mxCell><mxCell id="2 Κ-10" value='&lt;font color="#4A5663"&gt;Αίτημα για ανοιχτή υπόθεση: κωδικός χωρίς _Cust. Ο κωδικός _Cust επιλέγεται ανά λογαριασμό μόλις το μητρώο έχει την ένδειξη ανοιχτού/κλειστού· μέχρι τότε ισχύει πάντα ο κωδικός ανοιχτής υπόθεσης.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="685" width="1100" height="40" as="geometry"/></mxCell><mxCell id="2 Κ-11" value='&lt;b style="font-size:20px"&gt;Αυτόματα ή προς έλεγχο&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="1100" height="40" as="geometry"/></mxCell><mxCell id="2 Κ-12" value="&lt;b&gt;Αυτόματα&lt;/b&gt;, όταν δεν ισχύει κανένας λόγος ελέγχου:&lt;br&gt;&lt;br&gt;Βεβαιότητα 90% ή περισσότερο, ο πελάτης ταυτοποιήθηκε με ΑΦΜ ή λογαριασμό (ή καμία ενέργεια δεν χρειάζεται πελάτη, π.χ. προώθηση ή φάκελος Outlook), και ο λογαριασμός βρέθηκε." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;strokeColor=#1D7A4C;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="540" height="180" as="geometry"/></mxCell><mxCell id="2 Κ-13" value="&lt;b&gt;Προς έλεγχο&lt;/b&gt;, αν ισχύει έστω ένα:&lt;br&gt;&lt;br&gt;• Βεβαιότητα κάτω από το όριο (σήμερα 90%)&lt;br&gt;• Καμία κατηγορία δεν ταιριάζει, ή η ταξινόμηση απέτυχε&lt;br&gt;• Χρειάζεται πελάτης (αίτημα Qualco) αλλά δεν βρέθηκε με ΑΦΜ ή λογαριασμό&lt;br&gt;• Δεν ταυτοποιήθηκε ο λογαριασμός ή το SPV του αιτήματος&lt;br&gt;• Παράπονο μαζί με άλλο αίτημα&lt;br&gt;• Αυτοτραυματισμός ή απειλή νομικών μέτρων&lt;br&gt;• Οι ΑΦΜ του email οδηγούν σε διαφορετικές κατηγορίες&lt;br&gt;• Ένα συνημμένο δεν διαβάστηκε" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;fontSize=13;strokeColor=#A14D0E;" vertex="1" parent="1"><mxGeometry x="600" y="800" width="540" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3 Κατηγορίες" name="3 Κατηγορίες"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="2909" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 Κ-1" value='&lt;b style="font-size:20px"&gt;Ανά κατηγορία&lt;/b&gt; &lt;font color="#4A5663"&gt;· ταξινομημένες κατά προτεραιότητα · αν … → ενέργεια&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18212B;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="3 Κ-2" value='&lt;b style="font-size:14px"&gt;GDPR&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;62&lt;/b&gt; Αίτημα προσωπικών δεδομένων &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;132&lt;/b&gt; Αίτημα_προσωπικών_δεδομένων_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="520" height="136" as="geometry"/></mxCell><mxCell id="3 Κ-3" value='&lt;b style="font-size:14px"&gt;Αγωγές&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: — · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Προώθηση&lt;/b&gt; spdallas@dovaluegreece.gr, agoges@dovaluegreece.gr, OpRISK@dovaluegreece.gr, Complaints@dovaluegreece.gr' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="520" height="136" as="geometry"/></mxCell><mxCell id="3 Κ-4" value='&lt;b style="font-size:14px"&gt;Αιτήματα Ν.3869&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Λήψη αιτήματος · Portal: Ναι · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Το email επισυνάπτει την απόφαση του Ν.3869&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;161&lt;/b&gt; Προσκόμιση απόφασης Ν.3869 &lt;i&gt;(και με Portal)&lt;/i&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ο αποστολέας ρωτά ποια δόση πρέπει να πληρώσει&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;113&lt;/b&gt; N.3869/2010_Πληροφορίες δόσης_λογαριασμού &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;114&lt;/b&gt; N.3869/2010_Πληροφορίες δόσης_λογαριασμού_cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά βεβαίωση καταβολών ή τήρησης της δικαστικής ρύθμισης&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;103&lt;/b&gt; N.3869/2010_Βεβαίωση_Καταβολών &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;104&lt;/b&gt; N.3869/2010_Βεβαίωση Καταβολών_cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά βεβαίωση οφειλής&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;105&lt;/b&gt; N.3869/2010_Βεβαίωση_Οφειλής&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά αντιλογισμό πληρωμής&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;108&lt;/b&gt; N.3869/2010_Αντιλογισμός&lt;br&gt;• &lt;font color="#4A5663"&gt;Αμφισβητεί την οφειλή ή τις χρεώσεις&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;112&lt;/b&gt; N.3869/2010_Αμφισβήτηση_οφειλής&lt;br&gt;• &lt;font color="#4A5663"&gt;Αφορά απόφαση του Αρείου Πάγου&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;184&lt;/b&gt; Απόφαση Αρείου Πάγου&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά βεβαίωση για το πόθεν έσχες&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;109&lt;/b&gt; N.3869/2010_Βεβαίωση Πόθεν έσχες&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Χειρισμός από το προσωπικό&lt;/b&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="70" width="520" height="391" as="geometry"/></mxCell><mxCell id="3 Κ-5" value='&lt;b style="font-size:14px"&gt;Αιτήματα που αφορούν στον εξωδικαστικό 4605&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ο λογαριασμός&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Αμφισβητεί την οφειλή ή τις χρεώσεις&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;158&lt;/b&gt; Ν.4605_Αμφισβήτηση Οφειλής&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;78&lt;/b&gt; N4605 &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;127&lt;/b&gt; Ν4605_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="520" height="187" as="geometry"/></mxCell><mxCell id="3 Κ-6" value='&lt;b style="font-size:14px"&gt;Αιτήματα που αφορούν στον εξωδικαστικό 4738&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ο λογαριασμός&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Αμφισβητεί την οφειλή ή τις χρεώσεις&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;157&lt;/b&gt; N.4738_Αμφισβήτηση Οφειλής &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;159&lt;/b&gt; N.4738_Αμφισβήτηση Οφειλής_cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά το δοσολόγιο του Ν.4738&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;168&lt;/b&gt; Δοσολόγιο OCW &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;170&lt;/b&gt; Δοσολόγιο OCW_cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;81&lt;/b&gt; N4738 &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;129&lt;/b&gt; Ν4738_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="226" width="520" height="221" as="geometry"/></mxCell><mxCell id="3 Κ-7" value='&lt;b style="font-size:14px"&gt;Αναβολές δικασίμων&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Σε επεξεργασία · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Προώθηση&lt;/b&gt; Dikografa@dovaluegreece.gr&lt;br&gt;• &lt;font color="#4A5663"&gt;Στο μητρώο ο πελάτης είναι στον Ν.3869&lt;/font&gt; → &lt;b&gt;Προώθηση&lt;/b&gt; law3869_finalcourtdecisions@dovaluegreece.gr' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="433" width="520" height="153" as="geometry"/></mxCell><mxCell id="3 Κ-8" value='&lt;b style="font-size:14px"&gt;Διοίκηση&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Σε επεξεργασία · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Φάκελος Outlook&lt;/b&gt; «ΦΟΡΕΙΣ»' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="467" width="520" height="119" as="geometry"/></mxCell><mxCell id="3 Κ-9" value='&lt;b style="font-size:14px"&gt;Εξώδικα&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Φάκελος Outlook&lt;/b&gt; «NO MATCH FOUND»' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="481" width="520" height="119" as="geometry"/></mxCell><mxCell id="3 Κ-10" value='&lt;b style="font-size:14px"&gt;Ηχογραφημένες κλήσεις&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά να διατηρηθούν κλήσεις παλαιότερες του ενός έτους&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;ΔΙΑΤΗΡΗΣΗ ΚΛΗΣΕΩΝ&lt;/b&gt; REQ ΔΙΑΤΗΡΗΣΗ ΚΛΗΣΕΩΝ&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;85&lt;/b&gt; Αίτημα Παραλαβής Ηχογραφημένης Συνομιλίας &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;148&lt;/b&gt; Αίτημα_Παραλαβής_Ηχογραφημένης_Συνομιλίας_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="520" height="187" as="geometry"/></mxCell><mxCell id="3 Κ-11" value='&lt;b style="font-size:14px"&gt;Πλειστηριασμοί&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά να επικοινωνήσουμε μαζί του για διαπραγμάτευση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;40&lt;/b&gt; Νέα Ρύθμιση &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;142&lt;/b&gt; Νέα_Ρύθμιση_Cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Στέλνει μαζί και εξουσιοδότηση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;45&lt;/b&gt; Προσκόμιση Εξουσιοδότησης Πληρεξουσίου Δικηγόρου &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;124&lt;/b&gt; Προσκόμιση_Εξουσιοδότησης_Πληρεξουσίου_Δικηγόρου_Cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ο πλειστηριασμός είναι επικείμενος, μέσα στην εβδομάδα&lt;/font&gt; → &lt;b&gt;Προώθηση&lt;/b&gt; auctions_proceeds_collections_acquisition@dovaluegreece.gr, legalretail@dovaluegreece.gr, support_special_cases@dovaluegreece.gr, client_branch_reques@dovaluegreece.gr&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά ακύρωση πλειστηριασμού λόγω Ν.4738&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;81&lt;/b&gt; N4738&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά ακύρωση πλειστηριασμού λόγω Ν.4738&lt;/font&gt; → &lt;b&gt;Προώθηση&lt;/b&gt; L4738_Support@dovaluegreece.gr, auctions_proceeds_collections_acquisition@dovaluegreece.gr, legalretail@dovaluegreece.gr, client_branch_reques@dovaluegreece.gr&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Χειρισμός από το προσωπικό&lt;/b&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="606" width="520" height="340" as="geometry"/></mxCell><mxCell id="3 Κ-12" value='&lt;b style="font-size:14px"&gt;ΥΑΣ- Διαμεσολάβηση&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: — · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Προώθηση&lt;/b&gt; mediation@dovaluegreece.gr' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="620" width="520" height="119" as="geometry"/></mxCell><mxCell id="3 Κ-13" value='&lt;b style="font-size:14px"&gt;Φορείς&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: Σε επεξεργασία · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Φάκελος Outlook&lt;/b&gt; «ΦΟΡΕΙΣ»&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Activity Qualco&lt;/b&gt; &lt;b&gt;6691&lt;/b&gt; ΚΑΤΑΧΩΡΗΣΗ ΠΑΡΑΠΟΝΟΥ, &lt;b&gt;2090&lt;/b&gt; ΠΑΡΑΛΑΒΗ ΕΓΓΡΑΦΟΥ ΑΙΤΗΜΑΤΟΣ' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="759" width="520" height="153" as="geometry"/></mxCell><mxCell id="3 Κ-14" value='&lt;b style="font-size:14px"&gt;φόρμες παραπόνων&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 1 · Απάντηση: — · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Φάκελος Outlook&lt;/b&gt; «ΠΑΡΑΠΟΝΑ»' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="813" width="520" height="119" as="geometry"/></mxCell><mxCell id="3 Κ-15" value='&lt;b style="font-size:14px"&gt;Follow -up&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: — · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Activity Qualco&lt;/b&gt; —' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="932" width="520" height="119" as="geometry"/></mxCell><mxCell id="3 Κ-16" value='&lt;b style="font-size:14px"&gt;Αμφισβήτηση οφειλής&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ο λογαριασμός&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Στο μητρώο ο πελάτης είναι στον Ν.3869&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;112&lt;/b&gt; N.3869/2010_Αμφισβήτηση_οφειλής&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;146&lt;/b&gt; Αμφισβήτηση_Οφειλής &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;147&lt;/b&gt; Αμφισβήτηση_Οφειλής_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="952" width="520" height="187" as="geometry"/></mxCell><mxCell id="3 Κ-17" value='&lt;b style="font-size:14px"&gt;Αντίγραφα συμβάσεων&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ο λογαριασμός&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;154&lt;/b&gt; Χορήγηση_Συμβατικών Εγγράφων &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;155&lt;/b&gt; Χορήγηση_Συμβατικών Εγγράφων_cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="966" width="520" height="153" as="geometry"/></mxCell><mxCell id="3 Κ-18" value='&lt;b style="font-size:14px"&gt;Αντιλογισμοί&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Δεν έχει επισυνάψει τη φόρμα αντιλογισμού, οπότε του τη στέλνουμε για συμπλήρωση&lt;/font&gt; → &lt;b&gt;Απάντηση&lt;/b&gt; «Αποστολή φόρμας αντιλογισμού»&lt;br&gt;• &lt;font color="#4A5663"&gt;Στο μητρώο ο πελάτης είναι στον Ν.3869 · Έχει επισυνάψει τη φόρμα αντιλογισμού&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;108&lt;/b&gt; N.3869/2010_Αντιλογισμός&lt;br&gt;• &lt;font color="#4A5663"&gt;Στο μητρώο ο πελάτης δεν είναι στον Ν.3869 · Έχει επισυνάψει τη φόρμα αντιλογισμού&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;152&lt;/b&gt; Αντιλογισμός &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;153&lt;/b&gt; Αντιλογισμός_cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="1071" width="520" height="221" as="geometry"/></mxCell><mxCell id="3 Κ-19" value='&lt;b style="font-size:14px"&gt;Ασφαλιστήρια&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Στέλνει ασφαλιστήριο αντικατάστασης, όχι ανανέωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;61&lt;/b&gt; Προσκόμιση Νέου Ασφαλιστηρίου/Αντικατάσταση &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;137&lt;/b&gt; Προσκόμιση_Νέου_Ασφαλιστηρίου/Αντικατάσταση_Cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά πληροφορίες για ασφαλιστήριο πυρός ή σεισμού&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;162&lt;/b&gt; Πληροφορίες Ασφαλιστηρίου Πυρός/Σεισμού &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;163&lt;/b&gt; Πληροφορίες Ασφαλιστηρίου Πυρός/Σεισμού_Cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Αφορά ασφαλιστική αποζημίωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;164&lt;/b&gt; Ασφαλιστικές αποζημιώσεις&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;60&lt;/b&gt; Προσκόμιση Νέου Ασφαλιστηρίου/Ανανέωση &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;136&lt;/b&gt; Προσκόμιση_Νέου_Ασφαλιστηρίου/Ανανέωση_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="1139" width="520" height="272" as="geometry"/></mxCell><mxCell id="3 Κ-20" value='&lt;b style="font-size:14px"&gt;Βεβαίωση άρσης προσημείωσης&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ο λογαριασμός&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Ζητά μερική άρση προσημείωσης&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;52&lt;/b&gt; Αίτημα Μερικής Άρσης Προσημείωσης &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;139&lt;/b&gt; Αίτημα_Μερικής_Άρσης_Προσημείωσης_Cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;50&lt;/b&gt; Αίτημα Πλήρους Άρσης Προσημείωσης &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;100&lt;/b&gt; Αίτημα Πλήρους Άρσης Προσημείωσης_cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1159" width="520" height="187" as="geometry"/></mxCell><mxCell id="3 Κ-21" value='&lt;b style="font-size:14px"&gt;Βεβαιώσεις εξόφλησης&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;87&lt;/b&gt; Βεβαίωση_Εξόφλησης &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;99&lt;/b&gt; Βεβαίωση_Εξόφλησης_cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="1312" width="520" height="136" as="geometry"/></mxCell><mxCell id="3 Κ-22" value='&lt;b style="font-size:14px"&gt;Βεβαιώσεις οφειλής&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: Ναι · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Γράφει ως κληρονόμος αποβιώσαντος οφειλέτη&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;111&lt;/b&gt; Ειδική βεβαίωση_int &lt;i&gt;(και με Portal)&lt;/i&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Δεν γράφει ως κληρονόμος · Στο μητρώο ο πελάτης είναι στον Ν.3869&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;105&lt;/b&gt; N.3869/2010_Βεβαίωση_Οφειλής&lt;br&gt;• &lt;font color="#4A5663"&gt;Δεν γράφει ως κληρονόμος · Στο μητρώο ο πελάτης δεν είναι στον Ν.3869 · Ζητά και ανάλυση της οφειλής&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;91&lt;/b&gt; Βεβαίωση_Οφειλής_με_Ανάλυση &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;118&lt;/b&gt; Βεβαίωση_Οφειλής_με_Ανάλυση_Cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Δεν γράφει ως κληρονόμος · Στο μητρώο ο πελάτης δεν είναι στον Ν.3869 · Δεν ζητά ανάλυση της οφειλής&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;89&lt;/b&gt; Βεβαίωση_Οφειλής &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;117&lt;/b&gt; Βεβαίωση_Οφειλής_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="520" height="272" as="geometry"/></mxCell><mxCell id="3 Κ-23" value='&lt;b style="font-size:14px"&gt;Γνωστοποίησης κωδικού πληρωμής / δόσης&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Σε επεξεργασία · Portal: Ναι · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Φάκελος Outlook&lt;/b&gt; «NO MATCH FOUND» &lt;i&gt;(ή Portal)&lt;/i&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="1431" width="520" height="119" as="geometry"/></mxCell><mxCell id="3 Κ-24" value='&lt;b style="font-size:14px"&gt;Διαμεσολάβηση - ρύθμιση&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ο λογαριασμός&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;41&lt;/b&gt; Ρύθμιση με διαμεσολάβηση &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;141&lt;/b&gt; Ρύθμιση με διαμεσολάβηση_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="1468" width="520" height="153" as="geometry"/></mxCell><mxCell id="3 Κ-25" value='&lt;b style="font-size:14px"&gt;Δοσολόγιο&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: Ναι · Λογαριασμός: Ο λογαριασμός&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;144&lt;/b&gt; Πληροφορίες δόσης_λογαριασμού &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;145&lt;/b&gt; Πληροφορίες δόσης_λογαριασμού_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="1570" width="520" height="153" as="geometry"/></mxCell><mxCell id="3 Κ-26" value='&lt;b style="font-size:14px"&gt;Εθελοντική εκποίηση&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Το SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;42&lt;/b&gt; Εθελοντική Εκποίηση ακινήτου &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;143&lt;/b&gt; Εθελοντική Εκποίηση ακινήτου_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="1641" width="520" height="136" as="geometry"/></mxCell><mxCell id="3 Κ-27" value='&lt;b style="font-size:14px"&gt;Εξασφαλίσεις&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Το SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;51&lt;/b&gt; Αίτημα Αλλαγής Εξασφάλισης &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;140&lt;/b&gt; Αίτημα_Αλλαγής_Εξασφάλισης_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1658" width="520" height="136" as="geometry"/></mxCell><mxCell id="3 Κ-28" value='&lt;b style="font-size:14px"&gt;Εξουσιοδοτήσεις&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Το SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;45&lt;/b&gt; Προσκόμιση Εξουσιοδότησης Πληρεξουσίου Δικηγόρου &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;124&lt;/b&gt; Προσκόμιση_Εξουσιοδότησης_Πληρεξουσίου_Δικηγόρου_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="1743" width="520" height="136" as="geometry"/></mxCell><mxCell id="3 Κ-29" value='&lt;b style="font-size:14px"&gt;Επικαιροποίηση στοιχείων με επισύναψη υπεύθυνης δήλωσης&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Το SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Η υπόθεση ανήκει στην ERB, οπότε το χειρίζεται η τράπεζα&lt;/font&gt; → &lt;b&gt;Παραπομπή σε Eurobank&lt;/b&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Σε κάθε άλλη περίπτωση&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;64&lt;/b&gt; Αίτημα για επικαιροποίηση στοιχείων πελάτη (KYC) &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;131&lt;/b&gt; Αίτημα_για_επικαιροποίηση_στοιχείων_πελάτη (KYC)_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="1797" width="520" height="204" as="geometry"/></mxCell><mxCell id="3 Κ-30" value='&lt;b style="font-size:14px"&gt;Κίνηση λογαριασμού&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: Ναι · Λογαριασμός: Ο λογαριασμός&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;95&lt;/b&gt; Εκτύπωση_Αναλυτικής_Κίνησης &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;119&lt;/b&gt; Εκτύπωση_Αναλυτικής_Κίνησης_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1814" width="520" height="153" as="geometry"/></mxCell><mxCell id="3 Κ-31" value='&lt;b style="font-size:14px"&gt;Κώδικας δεοντολογίας&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Σε επεξεργασία · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Φάκελος Outlook&lt;/b&gt; «NO MATCH FOUND»' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="1899" width="520" height="119" as="geometry"/></mxCell><mxCell id="3 Κ-32" value='&lt;b style="font-size:14px"&gt;Νομιμοποίηση κληρονόμων με επισύναψη εγγράφων&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Το SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Η υπόθεση ανήκει στην ERB, οπότε το χειρίζεται η τράπεζα&lt;/font&gt; → &lt;b&gt;Παραπομπή σε Eurobank&lt;/b&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Η υπόθεση δεν ανήκει στην ERB&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;44&lt;/b&gt; Προσκόμιση Δικαιολογητικών Νομιμοποίησης Κληρονόμου &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;123&lt;/b&gt; Προσκόμιση_Δικαιολογητικών_Νομιμοποίησης_Κληρονόμου_Cust)&lt;/font&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Η υπόθεση δεν ανήκει στην ERB · Στέλνει πιστοποιητικό εγγυτέρων συγγενών ή ληξιαρχική πράξη θανάτου (activity 5005)&lt;/font&gt; → &lt;b&gt;Activity Qualco&lt;/b&gt; &lt;b&gt;5005&lt;/b&gt; Πιστοποιητικό εγγυτέρων συγγενών / ληξιαρχική πράξη&lt;br&gt;• &lt;font color="#4A5663"&gt;Η υπόθεση δεν ανήκει στην ERB · Στέλνει άλλα έγγραφα κληρονόμων (activity 5007)&lt;/font&gt; → &lt;b&gt;Activity Qualco&lt;/b&gt; &lt;b&gt;5007&lt;/b&gt; Λοιπά έγγραφα κληρονόμων' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1987" width="520" height="272" as="geometry"/></mxCell><mxCell id="3 Κ-33" value='&lt;b style="font-size:14px"&gt;Παράπονα&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: — · Portal: — · Λογαριασμός: —&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Πάντα&lt;/font&gt; → &lt;b&gt;Φάκελος Outlook&lt;/b&gt; «ΠΑΡΑΠΟΝΑ»' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="2021" width="520" height="119" as="geometry"/></mxCell><mxCell id="3 Κ-34" value='&lt;b style="font-size:14px"&gt;Πόθεν έσχες&lt;/b&gt;&lt;br&gt;&lt;font color="#4A5663"&gt;Προτ. 2 · Απάντηση: Λήψη αιτήματος · Portal: — · Λογαριασμός: Ανά SPV&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Η υπόθεση ανήκει στην ERB, οπότε το χειρίζεται η τράπεζα&lt;/font&gt; → &lt;b&gt;Παραπομπή σε Eurobank&lt;/b&gt;&lt;br&gt;• &lt;font color="#4A5663"&gt;Η υπόθεση δεν ανήκει στην ERB · Στο μητρώο ο πελάτης είναι στον Ν.3869&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;109&lt;/b&gt; N.3869/2010_Βεβαίωση Πόθεν έσχες&lt;br&gt;• &lt;font color="#4A5663"&gt;Η υπόθεση δεν ανήκει στην ERB · Στο μητρώο ο πελάτης δεν είναι στον Ν.3869&lt;/font&gt; → &lt;b&gt;Αίτημα Qualco&lt;/b&gt; &lt;b&gt;111&lt;/b&gt; Ειδική βεβαίωση_int &lt;font color="#4A5663"&gt;(κλειστή: &lt;b&gt;122&lt;/b&gt; Ειδική βεβαίωση_Cust)&lt;/font&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontFamily=Helvetica;fontColor=#18212B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="2038" width="520" height="221" as="geometry"/></mxC